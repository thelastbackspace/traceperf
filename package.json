{
  "name": "traceperf",
  "version": "0.2.1",
  "description": "See where the time goes: call trees in development, cheap per-function stats in production, export to Perfetto and OpenTelemetry. Node.js and browsers.",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "traceperf": "dist/cli.js"
  },
  "browser": "dist/browser.js",
  "typesVersions": {
    "*": {
      "browser": [
        "dist/browser.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/esm/browser.d.ts",
        "default": "./dist/esm/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:esm": "tsc -p tsconfig.esm.json && node scripts/postbuild-esm.js",
    "build:browser": "tsc -p tsconfig.browser.json && node scripts/build-browser-global.js",
    "build:all": "npm run build && npm run build:esm && npm run build:browser",
    "test": "jest",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky install",
    "prepublishOnly": "npm run build:all",
    "dev": "tsc --watch",
    "verify:package": "node scripts/verify-package.js",
    "lint:package": "publint --strict && attw --pack .",
    "test:browser": "playwright test",
    "verify:docs": "node scripts/check-docs.js",
    "verify": "npm run lint:package && npm run verify:package && npm run verify:docs",
    "bench": "node scripts/bench.js",
    "bench:check": "node scripts/bench.js --check",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "test:runtimes": "bun test/runtimes/smoke.mjs && deno run --allow-read --allow-env --allow-sys test/runtimes/smoke.mjs",
    "bench:compare": "node scripts/compare.js",
    "docs:api": "typedoc"
  },
  "keywords": [
    "performance",
    "profiling",
    "monitoring",
    "tracking",
    "execution",
    "function-tracing",
    "memory-tracking",
    "bottleneck-detection",
    "sampling",
    "debug",
    "optimization",
    "opentelemetry",
    "perfetto",
    "tracing",
    "express",
    "fastify",
    "hono",
    "decorators",
    "async-hooks"
  ],
  "author": "Shubh Wadekar",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thelastbackspace/traceperf.git"
  },
  "bugs": {
    "url": "https://github.com/thelastbackspace/traceperf/issues"
  },
  "homepage": "https://github.com/thelastbackspace/traceperf#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@aws-sdk/client-s3": "^3.1153.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/koa": "^2.15.2",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "edge-runtime": "^4.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.1",
    "express": "^5.3.0",
    "fastify": "^5.12.7",
    "hono": "^4.13.13",
    "husky": "^9.1.7",
    "ioredis": "^6.0.0",
    "jest": "^29.7.0",
    "koa": "^3.2.1",
    "mongodb": "^7.7.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "prettier": "^3.5.3",
    "publint": "^0.3.25",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.2.6",
    "typedoc": "^0.28.20",
    "typescript": "^5.8.2"
  },
  "sideEffects": false
}
