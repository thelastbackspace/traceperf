{
  "blocking": {
    "paths": ["/report", "/users"],
    "expect": [
      { "kind": "blocking", "includes": "GET /report" },
      { "kind": "blocked", "includes": "GET /report" }
    ]
  },
  "sequential": {
    "paths": ["/dashboard"],
    "expect": [{ "kind": "sequential", "includes": "awaited 3 calls" }]
  },
  "n-plus-one": {
    "paths": ["/orders"],
    "expect": [{ "kind": "repeated", "includes": "SELECT * FROM items WHERE order_id = ? 12 times" }]
  },
  "slow-dependency": {
    "paths": ["/checkout"],
    "expect": [{ "kind": "dominant", "includes": "POST payments.example/charge" }]
  },
  "errors": {
    "paths": ["/pay"],
    "expect": [{ "kind": "error", "includes": "payment provider timed out" }]
  }
}
