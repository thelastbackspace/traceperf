{
  "blocking": {
    "paths": [
      "/report",
      "/users"
    ],
    "expect": [
      {
        "kind": "blocking",
        "includes": "GET /report"
      },
      {
        "kind": "blocking",
        "includes": "buildReport"
      },
      {
        "kind": "blocked",
        "includes": "GET /report"
      }
    ]
  },
  "sequential": {
    "paths": [
      "/dashboard"
    ],
    "expect": [
      {
        "kind": "sequential",
        "includes": "awaited 3 calls"
      }
    ]
  },
  "n-plus-one": {
    "paths": [
      "/orders"
    ],
    "expect": [
      {
        "kind": "repeated",
        "includes": "SELECT * FROM items WHERE order_id = ? 12 times"
      }
    ]
  },
  "slow-dependency": {
    "paths": [
      "/checkout"
    ],
    "expect": [
      {
        "kind": "dominant",
        "includes": "POST payments.example/charge"
      }
    ]
  },
  "errors": {
    "paths": [
      "/pay"
    ],
    "expect": [
      {
        "kind": "error",
        "includes": "payment provider timed out"
      }
    ]
  },
  "blocking-native": {
    "paths": [
      "/export",
      "/login",
      "/ping"
    ],
    "expect": [
      {
        "kind": "blocking",
        "includes": "exportCatalog"
      },
      {
        "kind": "blocking",
        "includes": "hashPassword \u2192 pbkdf2Sync"
      },
      {
        "kind": "blocked",
        "includes": "GET /ping took"
      }
    ]
  },
  "http-n-plus-one": {
    "paths": [
      "/products"
    ],
    "expect": [
      {
        "kind": "repeated",
        "includes": "10 times"
      }
    ],
    "allow": [
      {
        "kind": "busy",
        "includes": ""
      }
    ],
    "note": "10 fetch() calls per request really cost ~10-20 ms of CPU (undici), so the busy finding is true; the case is about the N+1"
  },
  "parallel-n-plus-one": {
    "paths": [
      "/team"
    ],
    "expect": [
      {
        "kind": "repeated",
        "includes": "SELECT * FROM avatars WHERE user_id = ? 15 times"
      }
    ]
  },
  "blocking-zlib": {
    "paths": [
      "/backup",
      "/health"
    ],
    "expect": [
      {
        "kind": "blocking",
        "includes": "GET /backup"
      },
      {
        "kind": "blocked",
        "includes": "GET /health"
      }
    ]
  },
  "cpu-json": {
    "paths": [
      "/catalogue"
    ],
    "expect": [
      {
        "kind": "blocking",
        "includes": "GET /catalogue"
      }
    ]
  },
  "failing-route": {
    "paths": [
      "/invoices"
    ],
    "expect": [
      {
        "kind": "error",
        "includes": "500"
      }
    ]
  },
  "flaky-dependency": {
    "paths": [
      "/quote"
    ],
    "expect": [
      {
        "kind": "dominant",
        "includes": "shipping.example/quote"
      }
    ]
  },
  "clean-crud": {
    "paths": [
      "/user"
    ],
    "expect": []
  },
